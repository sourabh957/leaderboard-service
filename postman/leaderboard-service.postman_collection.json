{
  "info": {
    "_postman_id": "f65b407e-8d1a-4f7e-a98c-6b664b688aa9",
    "name": "Leaderboard Service - API and Flow Tests",
    "description": "Run in order against the locally running service. The first request creates unique run IDs. Successful completion removes seeded players. Retry receipts expire automatically. Redis is managed independently.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8082"
    },
    {
      "key": "gameId",
      "value": "postman-demo"
    },
    {
      "key": "leaderboardId",
      "value": "season-1"
    },
    {
      "key": "requestId",
      "value": "match-demo"
    }
  ],
  "item": [
    {
      "name": "01 - Health and initialize isolated run",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health/readiness"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"gameId\", \"postman-\" + Date.now() + \"-\" + Math.floor(Math.random() * 100000));",
              "pm.collectionVariables.set(\"requestId\", \"match-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const leaderboardResult = pm.response.json();",
              "pm.test(\"Response check 1\", () => { pm.expect(leaderboardResult.status).to.eql(\"UP\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Empty leaderboard",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/games/{{gameId}}/leaderboards/{{leaderboardId}}/entries"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const leaderboardResult = pm.response.json();",
              "pm.test(\"Response check 1\", () => { pm.expect(leaderboardResult.entries).to.eql([]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Set alice score",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/games/{{gameId}}/leaderboards/{{leaderboardId}}/players/alice/score",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 100\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const leaderboardResult = pm.response.json();",
              "pm.test(\"Response check 1\", () => { pm.expect(leaderboardResult.score).to.eql(100); });",
              "pm.test(\"Response check 2\", () => { pm.expect(leaderboardResult.playerId).to.eql(\"alice\"); });"
            ]
          }
        }
      ]
    },
